SCRAPER_USUARIO=tu_usuario
SCRAPER_PASSWORD=tu_contraseña
SCRAPER_URL_LOGIN=https://tu-sistema.com/login
SCRAPER_URL_POST_LOGIN=https://tu-sistema.com/platform
SCRAPER_URL_PEDIDOS=https://tu-sistema.com/orders
SCRAPER_URL_DETALLE=https://tu-sistema.com/orders/detail/
# DEC-039 — flujo de descarga del sistema administrativo
# (scraper/inventario.py). Validado con piloto 2026-07-23.
SCRAPER_URL_INVENTARIO=https://tu-sistema.com/shop/goods-center

# TASK-001 — vista "Cambios de inventario" del sistema administrativo
# (scraper/cambios_inventario.py). Misma sesión y usuario que arriba.
SCRAPER_URL_CAMBIOS_INVENTARIO=https://tu-sistema.com/shop/inventory/change

# DEC-039 — sistema de bodega BOCHICA (Google Apps Script, login Google
# Workspace separado del admin). Flujo completo (scraper/bochica.py) —
# login Google + login app + descarga — validado con piloto 2026-07-23.
BOCHICA_USUARIO=tu_correo@tu-dominio.com
BOCHICA_PASSWORD=tu_contraseña
BOCHICA_URL=https://script.google.com/tu-app-de-bodega

# Segunda capa de login dentro de la propia app de Bochica (el "usuario
# de miempresa") — distinta del login de Google de arriba
BOCHICA_APP_USUARIO=tu_usuario_de_la_app
BOCHICA_APP_PASSWORD=tu_contraseña

# AUD-M11 — opcionales. Defaults si se omiten: HEADLESS=false, SLOW_MO=50
# (comportamiento histórico). Producción corre con SCRAPER_HEADLESS=true
# (validado contra la SPA real el 2026-07-18; el ciclo de systemd no tiene
# sesión gráfica). false sirve para depurar viendo el navegador.
SCRAPER_HEADLESS=false
SCRAPER_SLOW_MO=50
# DEC-140: pedidos del histórico que re-extrae cada ciclo incremental (0 = apagado).
# 500 es el default del código; producción usa 800 (DEC-147).
SCRAPER_REEXTRACCION_POR_CICLO=500

# DEC-030 Fase 4 — opcional. Default si se omite: 5. Antes de subir este
# valor, medir con un piloto corto (throughput total, no solo latencia por
# pedido) — el óptimo no es monótono, ver docs/decisions.md.
SCRAPER_NUM_WORKERS=5

# DEC-144 — opcional. Un worker que no entra al arrancar reintenta el login
# durante el run: espera entre rondas (segundos) y número de rondas.
SCRAPER_LOGIN_REINTENTO_ESPERA_S=120
SCRAPER_LOGIN_REINTENTO_RONDAS=3

# DEC-148/150 — página nueva cada N pedidos por worker: la SPA del origen
# retiene ~13 MB de DOM por navegación interna. 0 (default del código) =
# apagado. Configuración de producción (DEC-150): 10 — con W=5 y V8, pico del
# ciclo ~1,4 GB (antes ~4,9 GB) y ciclo de 24-27 min (tope 30).
SCRAPER_PAGINA_NUEVA_CADA_N=10

# DEC-150 — el navegador del scraper no pide imágenes (driver ~-60 MB, ~-3% de
# tiempo; ninguna extracción las usa). false (default del código) = las pide.
SCRAPER_BLOQUEAR_IMAGENES=true

# DEC-150/154 — V8 prioriza memoria sobre velocidad en los navegadores del
# scraper y de BOCHICA (~-30% de memoria, ~+4% de tiempo). Requiere D3
# (DEC-152). false (default del código) = apagado.
SCRAPER_V8_OPTIMIZAR_TAMANO=true

# scripts/monitor_laptop_tailscale.py — IP de Tailscale de la laptop del
# trabajo (la que la ACL del tailnet ya usa como único origen permitido
# contra el dashboard). Sin esto, el script se queda callado y solo deja
# un ERROR en logs/laptop_tailscale.log.
TAILSCALE_IP_LAPTOP_TRABAJO=100.x.x.x

# integraciones/sheets_arena.py — exporta a Google Sheets el inventario
# Arena disponible y los pedidos previos a picking, por ciudad (pedido del
# Arquitecto, 2026-09-14). GOOGLE_SHEETS_CREDENTIALS es la ruta al JSON de
# la cuenta de servicio (gitignored, nunca commitear el archivo real);
# cada hoja debe compartirse con el email de esa cuenta de servicio, con
# permiso de Editor.
GOOGLE_SHEETS_CREDENTIALS=data/credenciales/google_service_account.json
SHEETS_ID_INVENTARIO_ARENA=tu_id_de_hoja
SHEETS_ID_PEDIDOS_PREVIOS_PICKING=tu_id_de_hoja

# scripts/respaldar_db.py (DEC-146) — opcional. Días de respaldo diario de
# pedidos.db y tareas.db que se conservan en data/backups/. Default: 7.
# RESPALDO_DIAS=7

# scripts/notificar_fallo_email.py (DEC-161) — opcional. Aviso por email
# cuando un ciclo tiene al menos un paso fallido; vía de repliegue de
# notify-send, confirmado roto sin sesión gráfica (DEC-120). Sin estas 4
# variables, el script queda en no-op explicado en el log — nunca rompe el
# ciclo. Probado con SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 y una
# contraseña de aplicación (no la contraseña normal de la cuenta).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USUARIO=tu_correo@gmail.com
# SMTP_PASSWORD=contraseña_de_aplicacion
# SMTP_DESTINATARIO=tu_correo@gmail.com
# SMTP_REMITENTE=tu_correo@gmail.com

# scripts/respaldar_remoto.py (DEC-161) — opcional. Copia el respaldo diario
# ya verificado a un destino fuera de esta máquina (con rsync sobre SSH).
# El límite conocido de DEC-146 es que el respaldo diario vive en el mismo
# disco — esto lo resuelve, PERO el destino y el acceso SSH hay que
# decidirlos y configurarlos aparte (una clave sin passphrase o un agente
# ya cargado; este script nunca pide una contraseña interactiva). Sin estas
# 2 primeras variables, queda en no-op explicado en el log.
# RESPALDO_REMOTO_HOST=otro-equipo.ejemplo.com
# RESPALDO_REMOTO_RUTA=/home/usuario/respaldos_dashboard_pedidos
# RESPALDO_REMOTO_USUARIO=usuario
# RESPALDO_REMOTO_PUERTO=22
