# Timer systemd — dispara dashboard_pedidos_ciclo.service cada hora en punto
# (DEC-125).
#
# Si el servicio de la hora anterior sigue corriendo, systemd no arranca una
# segunda instancia de la misma unidad — crítico el día 1, cuando la pasada
# de mantenimiento hace que el ciclo dure ~60 min (DEC-092/155).
#
# Instalar: ver comentario en dashboard_pedidos_ciclo.service

[Unit]
Description=dashboard_pedidos - dispara el ciclo horario cada hora en punto

[Timer]
OnCalendar=*-*-* *:00:00
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
